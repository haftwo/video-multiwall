# Copy to .env and edit. Every setting is optional except where noted.

# ---- first admin account (only used the first time the container starts) ----
ADMIN_USERNAME=admin
# If left blank, a random password is generated and printed in the container log.
ADMIN_PASSWORD=

# ---- how people reach the site ----
# Public address, no trailing slash. REQUIRED for Microsoft sign-in, and it must
# be https:// (Microsoft only allows http:// for localhost).
# BASE_URL=https://wall.example.com
BASE_URL=

# ---- Microsoft Entra ID (Azure AD) single sign-on ----
# Leave these three blank to run with local accounts only.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# true  = anyone in your tenant can sign in and becomes a viewer
# false = only people an admin has pre-approved by email in the admin console
ENTRA_AUTO_PROVISION=true
# Comma-separated. These people are made administrators when they sign in.
ENTRA_ADMIN_EMAILS=
# Comma-separated. Limit sign-in to these email domains (blank = whole tenant).
ENTRA_ALLOWED_DOMAINS=

# ---- optional tuning ----
APP_NAME=MultiPlayer 2000
MAX_PANELS=16
SESSION_DAYS=7
# Set false to force everyone through Microsoft (keep it true until SSO works!)
LOCAL_LOGIN_ENABLED=true
# Adds three public test streams on first start so the wall is not empty.
SEED_DEMO_CHANNELS=true
# Normally worked out from BASE_URL. Override only if you know you need to.
# COOKIE_SECURE=true
# TRUST_PROXY=1
# SESSION_SECRET=
